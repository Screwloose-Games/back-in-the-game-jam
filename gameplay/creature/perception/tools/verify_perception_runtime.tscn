[gd_scene load_steps=2 format=3]

; A wrapper, and it is not optional. Nodes added during SceneTree._initialize()
; never receive _ready(), so running verify_perception_runtime.gd as `--script`
; would execute nothing, print nothing and exit 0 -- which looks exactly like a pass.

[ext_resource type="Script" path="verify_perception_runtime.gd" id="1"]

[node name="VerifyPerceptionRuntime" type="Node"]
script = ExtResource("1")
