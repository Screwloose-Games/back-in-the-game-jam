[node name="ElevatorCar" parent="." instance=ExtResource("1_car")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1.42, 0)

; THE SAME TRANSFORM AS THE CAR, which is the reason the frame lives in this
; scene rather than beside it in the level. Both prefabs put their origin on the
; plane the car stands on, so the two line up with no offset to remember and
; cannot be moved apart by editing one file.
;
; The heights are fitted to the bay level_mine_blockout.tscn carves: 7.68 m of
; frame fills the winze bore, and the collar is seated so its bottom step hangs
; below the lowest point of the seam where the chamber ceiling meets that bore.
