[node name="ElevatorOutro" type="Node3D" unique_id=60046100 node_paths=PackedStringArray("player_start", "player_exit")]
script = ExtResource("0_outro")
player_start = NodePath("PlayerStart")
player_exit = NodePath("PlayerExit")

; The same y offset the intro uses, and for the same reason: both prefabs put their origin
; on the plane the car stands on, so the two line up with no offset to remember.
[node name="ElevatorCar" parent="." unique_id=60046101 instance=ExtResource("1_car")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1.42, 0)

[node name="ElevatorShaft" parent="." unique_id=60046102 instance=ExtResource("2_shaft")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1.42, 0)
shaft_height = 7.68
beam_spacing = 1.8
first_beam_height = 3.36
hood_height = 5.52

; Floating in the middle of the car, clear of the floor and of both leaves. The exit is the
; same spot: the run ends here, so there is nowhere to hand control back to.
[node name="PlayerStart" type="Marker3D" parent="." unique_id=60046103]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.02, 0.8)

[node name="PlayerExit" type="Marker3D" parent="." unique_id=60046104]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.02, 0.8)

; process_priority 10 so the driver runs AFTER the AnimationPlayer that writes the anchor.
[node name="CutsceneCamera" type="Camera3D" parent="." unique_id=60046105]
process_priority = 10
current = false
fov = 62.0
script = ExtResource("3_camera")

; Node3D, NOT Node. A plain Node here detaches everything below it from the 3D hierarchy:
; Cutscenes/ElevatorOutro would become its own transform root and the whole shot would play
; at the world origin however the level placed this scene. Nothing errors.
[node name="Cutscenes" type="Node3D" parent="." unique_id=60046106]

[node name="ElevatorOutro" type="Node3D" parent="Cutscenes" unique_id=60046107]
script = ExtResource("4_cutscene")
data = ExtResource("6_cutscenedata")

[node name="AnimationPlayer" type="AnimationPlayer" parent="Cutscenes/ElevatorOutro" unique_id=60046108]
root_node = NodePath("../../..")
libraries = {
&"": ExtResource("5_animlib")
}

[node name="CameraAnchor" type="Node3D" parent="Cutscenes/ElevatorOutro" unique_id=60046109]
