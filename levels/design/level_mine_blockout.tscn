[node name="MineBlockout" type="Node3D" unique_id=1601177174]
script = ExtResource("1_k1nl5")
notes = "Where the player starts. The mines are kept simple to ease the player into the game. They have initially no choice where to go--only forward--and are gradually given more options and put in increasingly disorienting spaces. The mines are the smallest biome and the least rewarding. They should contain only sparse, low tier minerals, though they should contain a mineral almost immediately near the entrance to teach the player about mining."
color_mode = 1
creature_min_width = 4.0
creature_squeeze_width = 2.0
tag_colors = Dictionary[StringName, Color]({
&"biome_link": Color(1, 0.85, 0.2, 1),
&"drift": Color(0.35, 0.62, 1, 1),
&"entrance": Color(0.95, 0.95, 0.5, 1),
&"natural": Color(0.95, 0.62, 0.25, 1),
&"refuge": Color(0.3, 0.9, 0.5, 1),
&"strip": Color(0.55, 0.78, 0.95, 1),
&"unbuilt": Color(0.5, 0.5, 0.55, 1),
&"winze": Color(0.85, 0.35, 0.9, 1)
})
entrance_space = NodePath("Spaces/mine_mouth")
sound_origin = NodePath("Spaces/pocket")

[node name="Spaces" type="Node3D" parent="." unique_id=179536954]

[node name="mine_mouth" type="Node3D" parent="Spaces" unique_id=506200350]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -94.7803, -37.928627, 2.175349)
script = ExtResource("2_6b4y6")
radius = 5.25
vertical_scale = 0.6215
tags = Array[StringName]([&"entrance"])
notes = "Where the player starts. The first stretch east is one straight tunnel with no choices at all, so the map is taught before it is used.

RAISED AND FLATTENED TO MEET THE ELEVATOR. This was a true sphere centred on %PlayerSpawn, and its floor came out around y -37.2 while the car's deck sits at -34.14 - so the opening shot ended with the player dropping three metres out of the doorway. The carver unions every hull and only then subtracts every bore, so nothing can add rock back under the car; the chamber itself is the only thing that can move. Centre y -31.0 world with a 0.6215 vertical scale puts the floor on the car's base plane, and neither %PlayerSpawn nor the elevator had to move for it, which is what keeps verify_elevator_intro's PlayerExit assertion true."

[node name="elevator_winze_base" type="Node3D" parent="Spaces" unique_id=506200351]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -97.33034, -38.581726, 0.70532)
script = ExtResource("2_6b4y6")
kind = 1
radius = 0.0
tags = Array[StringName]([&"winze"])
notes = "Foot of the elevator bay. RADIUS ZERO ON PURPOSE: _chamber_brush returns null below zero radius, so this marker contributes no sphere and exists only to give the winze span an end. A chamber here would round off the flat walls the span is carved to produce."

[node name="elevator_winze_head" type="Node3D" parent="Spaces" unique_id=506200352]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -97.33034, -36.361725, 0.70532)
script = ExtResource("2_6b4y6")
kind = 1
radius = 0.0
tags = Array[StringName]([&"winze"])
notes = "Head of the elevator bay, two metres above its foot. The span is short because _overrun_at adds half the bore's width at each end of a terminus - 2.85 m here - so these two markers carve 7.9 m of shaft between them. Move them apart and the bay grows by twice what you moved."

