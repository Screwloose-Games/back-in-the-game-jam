[layer_names]

3d_render/layer_1="world"
3d_render/layer_11="own_body"
3d_render/layer_12="own_viewmodel"
3d_render/layer_13="own_tool"
3d_render/layer_14="peer_suit"
3d_physics/layer_1="hull"
3d_physics/layer_2="player"
3d_physics/layer_3="debris"
3d_physics/layer_4="carryable"
3d_physics/layer_5="creature"
3d_physics/layer_6="ore"
3d_physics/layer_7="loose_crystal"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
