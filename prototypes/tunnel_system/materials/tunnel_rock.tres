[gd_resource type="StandardMaterial3D" format=3]

; Per-pixel and lit, NOT unshaded. The helmet lamp is the only light down here,
; and unlit rock would throw away the single depth cue the player has in a
; sealed tunnel with no horizon and no up.

[resource]
resource_name = "TunnelRock"
albedo_color = Color(0.3, 0.29, 0.28, 1)
metallic = 0.0
metallic_specular = 0.2
roughness = 0.95
