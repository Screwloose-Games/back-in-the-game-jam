[gd_resource type="StandardMaterial3D" format=3]

; Unshaded, and it carries its colour as VERTEX COLOUR so one material serves
; every beacon hue from a single MultiMesh. Godot does not infer
; vertex_color_use_as_albedo - it is asserted here rather than trusted.

[resource]
resource_name = "JunctionBeacon"
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(1, 1, 1, 1)
emission_enabled = true
emission = Color(1, 1, 1, 1)
emission_energy_multiplier = 3.0
