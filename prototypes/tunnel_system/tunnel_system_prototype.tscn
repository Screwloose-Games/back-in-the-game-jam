[gd_scene load_steps=8 format=3]

; The runnable scene. Both instanced children are GENERATED - Paths by
; tools/build_tunnel_paths.gd, Geometry by tools/bake_tunnel_mesh.gd - and the
; player is added from script rather than placed here, so the spawn stays a
; single value in tunnel_knobs.gd. See tunnel_system_prototype.gd.
;
; There is no DirectionalLight3D and there must not be one: the cave shell is
; sealed, so a light outside it is fully occluded and renders the whole interior
; at flat ambient, which looks exactly like a broken material. The helmet lamp on
; the player is the only light down here.

[ext_resource type="Script" path="res://prototypes/tunnel_system/tunnel_system_prototype.gd" id="0_root"]
[ext_resource type="PackedScene" path="res://prototypes/tunnel_system/paths/tunnel_paths.tscn" id="1_paths"]
[ext_resource type="PackedScene" path="res://prototypes/tunnel_system/baked/tunnel_geometry.tscn" id="2_geometry"]
[ext_resource type="Script" path="res://prototypes/tunnel_system/tunnel_hud.gd" id="3_hud"]
[ext_resource type="Script" path="res://prototypes/tunnel_system/tunnel_map_overlay.gd" id="4_map"]
[ext_resource type="Script" path="res://prototypes/tunnel_system/tunnel_tuning_panel.gd" id="5_tuning"]

