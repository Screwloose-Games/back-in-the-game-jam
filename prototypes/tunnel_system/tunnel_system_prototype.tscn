; Bottom left, sized to its own content: zero width/height offsets plus the
; bottom-left grow directions make it expand right and upward from the corner,
; so adding a teleport stop does not need the box resized by hand.
[node name="Tuning" type="PanelContainer" parent="Hud"]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_bottom = -16.0
grow_vertical = 0
script = ExtResource("5_tuning")
