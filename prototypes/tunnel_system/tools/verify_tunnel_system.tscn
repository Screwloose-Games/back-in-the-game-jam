[gd_scene load_steps=2 format=3]

; This wrapper exists only so the suite can be NAMED ON THE COMMAND LINE as a
; scene. Nodes added during SceneTree._initialize() never receive _ready(), so
; running verify_tunnel_system.gd as a bare --script would print nothing and
; exit 0 - which looks exactly like a pass.

[ext_resource type="Script" path="res://prototypes/tunnel_system/tools/verify_tunnel_system.gd" id="0_verify"]

[node name="VerifyTunnelSystem" type="Node"]
script = ExtResource("0_verify")
